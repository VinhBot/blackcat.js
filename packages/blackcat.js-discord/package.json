{
  "name": "blackcat.js-discord",
  "version": "1.0.2",
  "description": "discord.js wrapper for blackcat.js",
  "author": "Nguyen Vinh",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "docs": "typedoc",
    "build:all": "npm run build && npm run docs"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.17",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "discord.js": "^14.25.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "discord.js",
    "discordjs",
    "blackcat.js",
    "discord-commando",
    "discord",
    "blackcat.js",
    "blackcat.js-discord",
    "blackcat.js-database"
  ]
}
