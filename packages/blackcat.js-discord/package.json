{
  "name": "blackcat.js-discord",
  "version": "1.0.9",
  "description": "Một lớp bao bọc mạnh mẽ cho discord.js được thiết kế bởi framework blackcat.js.",
  "author": "Nguyen Vinh",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "docs": "typedoc",
    "build:all": "node --run build && node --run docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinhBot/blackcat.js.git",
    "directory": "packages/blackcat.js-discord"
  },
  "bugs": {
    "url": "https://github.com/VinhBot/blackcat.js/issues"
  },
  "homepage": "https://blackcatjs-discord-docs.vercel.app/",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "discord",
    "discord.js",
    "discordjs",
    "discord bot",
    "discord framework",
    "blackcat.js",
    "blackcat.js-discord"
  ],
  "dependencies": {
    "discord.js": "^14.25.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.17",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^5.9.3"
  }
}
