{
  "entryPoints": ["src/index.ts"],
  "out": "docs",
  "plugin": ["typedoc-rhineai-theme"],
  "excludePrivate": true,
  "excludeProtected": true,
  "includeVersion": true,
  "disableSources": true,
  "readme": "README.md",
  "name": "blackcat.js-discord",
  "externalSymbolLinkMappings": {
    "discord.js": {
      "Client": "https://discord.js.org/docs/packages/discord.js/stable/Client",
      "User": "https://discord.js.org/docs/packages/discord.js/stable/User"
    }
  }
}