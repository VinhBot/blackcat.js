{
  "name": "blackcat.js-database",
  "version": "1.0.6",
  "description": "json datatabase driver for blackcat.js",
  "author": "Nguyen Vinh",
  "license": "ISC",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "docs": "typedoc",
    "dev": "npx tsx test/index.ts",
    "build:all": "node --run build && node --run docs"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.18",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "blackcat.js",
    "database",
    "mongoose",
    "mongodb",
    "jsondb",
    "jsondata",
    "memory",
    "memorydata",
    "quick-database",
    "better-sqlite3"
  ],
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.3"
  }
}
