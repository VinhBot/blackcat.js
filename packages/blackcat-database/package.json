{
  "name": "blackcat.js-database",
  "version": "1.1.0",
  "description": "JSON-path database library (drivers: JSON, Memory, SQLite, MongoDB + cache/encryption/compression/mirror wrappers)",
  "author": "Nguyen Vinh",
  "license": "ISC",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.mjs",
      "require": "./dist/sqlite.cjs"
    },
    "./mongo": {
      "types": "./dist/mongo.d.ts",
      "import": "./dist/mongo.mjs",
      "require": "./dist/mongo.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "docs": "typedoc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build:all": "npm run build && npm run docs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "better-sqlite3": "^12.6.2",
    "mongodb": "^7.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.18",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "blackcat.js",
    "database",
    "discord",
    "discord.js",
    "mongodb",
    "jsondb",
    "memory",
    "quick-database",
    "better-sqlite3",
    "cache",
    "key-path"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "better-sqlite3": ">=9.0.0",
    "mongodb": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    }
  }
}
