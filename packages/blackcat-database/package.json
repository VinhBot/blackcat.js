{
  "name": "blackcat.js-database",
  "version": "1.0.0-test",
  "description": "json datatabase driver for blackcat.js",
  "author": "Nguyen Vinh",
  "license": "ISC",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "node --test"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "database",
    "mongoose",
    "mongodb",
    "jsondb",
    "jsondata",
    "quick-database"
  ],
  "dependencies": {
    "mongoose": "^9.2.3"
  }
}
